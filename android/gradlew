#!/usr/bin/env sh

# Lightweight Gradle launcher for CI.

set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
GRADLE_VERSION="7.6.3"
GRADLE_DIST="gradle-${GRADLE_VERSION}-bin.zip"
GRADLE_URL="https://services.gradle.org/distributions/${GRADLE_DIST}"
GRADLE_CACHE_DIR="${HOME}/.gradle/wrapper-cache"
GRADLE_HOME="${GRADLE_CACHE_DIR}/gradle-${GRADLE_VERSION}"
GRADLE_BIN="${GRADLE_HOME}/bin/gradle"

if [ ! -x "${GRADLE_BIN}" ]; then
  mkdir -p "${GRADLE_CACHE_DIR}"
  TMP_ZIP="${GRADLE_CACHE_DIR}/${GRADLE_DIST}"

  if [ ! -f "${TMP_ZIP}" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    curl -L -o "${TMP_ZIP}" "${GRADLE_URL}"
  fi

  echo "Installing Gradle..."
  unzip -q "${TMP_ZIP}" -d "${GRADLE_CACHE_DIR}"
  chmod +x "${GRADLE_BIN}"
fi

cd "${APP_HOME}"
exec "${GRADLE_BIN}" "$@"